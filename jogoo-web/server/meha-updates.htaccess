# jogoo.africa/meha-updates — live-update bundles for the Jogoo Meha Android app
Options -Indexes
<IfModule mod_headers.c>
  # The app (origin https://localhost) reads latest.json with fetch().
  Header always set Access-Control-Allow-Origin "*"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Robots-Tag "noindex"
  <Files "latest.json">
    Header set Cache-Control "no-store"
  </Files>
  <FilesMatch "^bundle-[0-9]+\.zip$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
<FilesMatch "^(?!latest\.json$|bundle-[0-9]+\.zip$).+">
  Require all denied
</FilesMatch>
